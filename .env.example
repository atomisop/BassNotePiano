# Database — Neon Postgres
#
# Locally (no pooler in front of your DB): both vars point at the same
# database, e.g.
#   DATABASE_URL="postgresql://user@127.0.0.1:5432/ethiopian_scales?schema=public"
#   DIRECT_URL="postgresql://user@127.0.0.1:5432/ethiopian_scales?schema=public"
#
# On Neon: copy the "Pooled connection" string from your project dashboard
# for DATABASE_URL (used by the running app), and the "Direct connection"
# string for DIRECT_URL (used only by `prisma migrate`). Append
# `&pgbouncer=true` to the pooled URL — Prisma needs that flag to behave
# correctly through PgBouncer's transaction-mode pooling.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ethiopian_scales?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ethiopian_scales?sslmode=require"

# NextAuth
# In production set this to your real deployed URL, e.g.
# https://bassnotepiano.com (or the Netlify default until the custom domain is attached)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical public origin — the one URL the site claims to live at.
#
# Drives <link rel="canonical">, og:url, the sitemap and robots.txt (see
# src/lib/site.ts). Optional: if unset it falls back to NEXTAUTH_URL, and then
# to https://bassnotepiano.com, so a correctly configured deploy already works
# without it.
#
# Set it explicitly anyway on Netlify. Deploy previews get their own
# NEXTAUTH_URL, and without this every preview would publish canonical tags
# pointing at itself — which is how a preview URL ends up competing with the
# real domain in search results. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://bassnotepiano.com"

# Zelle (manual verification)
ZELLE_HANDLE="payments@bassnotepiano.com"

# Resend (transactional email — signup verification, login codes, password
# reset, account-change confirmations). Create an account at resend.com,
# verify noreply.bassnotepiano.com as a sending domain (a subdomain, so the
# root domain's own DNS is untouched), and generate an API key.
# Locally, if this is left unset, codes are logged to the server console
# instead of emailed, so the whole flow is still testable without a key.
RESEND_API_KEY=""
EMAIL_FROM="Bass Note Piano <noreply@noreply.bassnotepiano.com>"

# Object storage (Cloudflare R2) — admin-uploaded course lesson videos/PDFs.
# Uploads go straight from the admin's browser to the bucket via a
# presigned URL (see src/lib/storage.ts) — the app server never touches
# the file bytes, so there's no Netlify function body-size ceiling on
# lesson file size.
#
# One-time setup in the Cloudflare dashboard:
#   1. R2 > Create bucket.
#   2. R2 > Manage API tokens > Create API token, scoped to that bucket —
#      gives you the Access Key ID + Secret Access Key below.
#   3. Open the bucket > Settings > Public access > enable the r2.dev
#      subdomain (or attach a custom domain) — lessons are fetched directly
#      by <video>/<iframe> in the browser, so the bucket must be publicly
#      readable. That subdomain/custom domain is R2_PUBLIC_URL below.
#   4. Your account ID is shown on the R2 overview page (also in the
#      dashboard URL: dash.cloudflare.com/<account id>/r2).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="bass-note-piano-lessons"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
