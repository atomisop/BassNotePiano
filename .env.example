# Database, Neon Postgres
#
# Locally (no pooler in front of your DB): both vars point at the same
# database, e.g.
#   DATABASE_URL="postgresql://user@127.0.0.1:5432/ethiopian_scales?schema=public"
#   DIRECT_URL="postgresql://user@127.0.0.1:5432/ethiopian_scales?schema=public"
#
# On Neon: copy the "Pooled connection" string from your project dashboard
# for DATABASE_URL (used by the running app), and the "Direct connection"
# string for DIRECT_URL (used only by `prisma migrate`). Append
# `&pgbouncer=true` to the pooled URL, Prisma needs that flag to behave
# correctly through PgBouncer's transaction-mode pooling.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/ethiopian_scales?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ethiopian_scales?sslmode=require"

# NextAuth
# In production set this to your real deployed URL, e.g.
# https://bassnotepiano.com (or the Netlify default until the custom domain is attached)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Canonical public origin, the one URL the site claims to live at.
#
# Drives <link rel="canonical">, og:url, the sitemap and robots.txt (see
# src/lib/site.ts). Optional: if unset it falls back to NEXTAUTH_URL, and then
# to https://bassnotepiano.com, so a correctly configured deploy already works
# without it.
#
# Set it explicitly anyway on Netlify. Deploy previews get their own
# NEXTAUTH_URL, and without this every preview would publish canonical tags
# pointing at itself, which is how a preview URL ends up competing with the
# real domain in search results. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://bassnotepiano.com"

# Zelle (manual verification)
ZELLE_HANDLE="payments@bassnotepiano.com"
# Venmo username without the @. Defaults to BassNotePiano. Public on purpose.
NEXT_PUBLIC_VENMO_HANDLE="BassNotePiano"
# Shared secret for scripts/gmail-payment-forwarder.gs (24+ random characters). Leave empty to turn email matching off.
PAYMENT_EMAIL_SECRET=""

# Mailgun HTTP webhook signing key (Mailgun dashboard > Sending > Webhooks > HTTP webhook signing key).
# Verifies mail posted to /api/inbound/mailgun by the route for music@bassnotepiano.com, which feeds
# Support Chat's Email tab. Unset = that endpoint refuses everything.
MAILGUN_SIGNING_KEY=""

# Optional but recommended: a free outside monitor so a dead scheduler, database or site is noticed from outside.
# Make a check at healthchecks.io (period 1 hour, grace 1 hour), paste its ping URL here. The job watchdog
# (netlify/functions/job-watchdog.ts, every 30 minutes) pings it, and pings /fail when a scheduled job stopped.
HEALTHCHECK_PING_URL=""

# Resend (transactional email, signup verification, login codes, password
# reset, account-change confirmations). Create an account at resend.com,
# verify bassnotepiano.com as a sending domain, and generate an API key.
# Locally, if this is left unset, codes are logged to the server console
# instead of emailed, so the whole flow is still testable without a key.
RESEND_API_KEY=""
EMAIL_FROM="Bass Note Piano <noreply@bassnotepiano.com>"
# Where a real reply to any app email actually lands (not the noreply
# sender above). Also shown in the email footer as a contact address.
EMAIL_REPLY_TO="music@bassnotepiano.com"

# Object storage (Cloudflare R2), admin-uploaded course lesson videos/PDFs.
# Uploads go straight from the admin's browser to the bucket via a
# presigned URL (see src/lib/storage.ts), the app server never touches
# the file bytes, so there's no Netlify function body-size ceiling on
# lesson file size.
#
# One-time setup in the Cloudflare dashboard:
#   1. R2 > Create bucket.
#   2. R2 > Manage API tokens > Create API token, scoped to that bucket,
#      gives you the Access Key ID + Secret Access Key below.
#   3. Open the bucket > Settings > Public access > enable the r2.dev
#      subdomain (or attach a custom domain), lessons are fetched directly
#      by <video>/<iframe> in the browser, so the bucket must be publicly
#      readable. That subdomain/custom domain is R2_PUBLIC_URL below.
#   4. Your account ID is shown on the R2 overview page (also in the
#      dashboard URL: dash.cloudflare.com/<account id>/r2).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="bass-note-piano-lessons"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Error monitoring (STEP 21): GlitchTip (app.glitchtip.com), not Sentry.io.
# GlitchTip speaks the same event-ingestion protocol Sentry does, so the real
# @sentry/nextjs SDK (imported in instrumentation-client.ts, sentry.server.
# config.ts, sentry.edge.config.ts) still works completely unmodified. The
# DSN below is just pointed at GlitchTip's ingest URL instead of sentry.io.
#
# The app runs completely fine with none of this set: those three config
# files all pass an empty dsn to Sentry.init, which is a documented no-op, so
# error monitoring is simply off rather than broken.
#
# One-time setup at app.glitchtip.com (free tier, no card required):
#   1. Create an account, then create a project (Platform: Next.js, or
#      generic "Node.js"; either just sets a label, doesn't change ingestion).
#   2. The project's page shows its DSN directly under its settings, and
#      that's SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN below (same value, both
#      vars; the client bundle needs the NEXT_PUBLIC_ one to read it, the
#      server reads the plain one).
#
# No SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN here on purpose: those
# only drive Sentry.io's own source-map-upload API (next.config.mjs's
# withSentryConfig), which GlitchTip doesn't have an equivalent of. Leaving
# them unset makes that step no-op gracefully rather than trying to authenticate
# against an unrelated Sentry.io org. Production stack traces show minified
# code instead of real source as a result; everything else works the same.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Atom, the "ask me anything" assistant widget (src/lib/assistant.ts),
# floating on every page. Uses Google's Gemini API (a Google AI Studio key),
# which has a free tier with rate limits and paid tiers above that, see
# ai.google.dev/pricing.
#
# Locally, if this is left unset, the widget still renders (so the UI is
# always testable) but every message gets a canned "I'm not set up yet"
# reply instead of a real answer, same "degrade, don't crash" pattern as
# RESEND_API_KEY above.
#
# Get a key at aistudio.google.com > Get API key > Create API key.
GOOGLE_AI_API_KEY=""

# Cloudflare Turnstile (human check on sign-up and the public class form).
# Free: dash.cloudflare.com > Turnstile > Add widget (hostname = your domain).
# Both unset = no CAPTCHA (local dev). Set both in Netlify to turn it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: comma-separated hostnames Turnstile tokens must come from, e.g. bassnotepiano.com,www.bassnotepiano.com
TURNSTILE_HOSTNAMES=

# Text messages (phone verification), via Plivo Verify. OPTIONAL, and NOT free: Plivo charges per text.
# Plivo's Verify service makes, sends and checks the 6-digit code itself. Create a Verify application in the
# Plivo console (code length, expiry and the message wording are set there) and copy its UUID. Without the
# first two the phone step is switched off in production (and in development the code is printed to the
# server log), so a missing key can never lock anyone out.
PLIVO_AUTH_ID=""
PLIVO_AUTH_TOKEN=""
# Optional: a specific Verify application. Leave empty to use the account's default one.
PLIVO_VERIFY_APP_UUID=""
# Private payments address token (24+ random hex chars): mail to pay-<token>@inbox.bassnotepiano.com is read as payment emails.
PAYMENT_INBOX_TOKEN=
