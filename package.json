{
  "name": "bass-note-piano",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "sh -c 'if [ -n \"$DATABASE_URL\" ]; then npx prisma migrate deploy; fi' && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "hooks:on": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "upload:media": "tsx scripts/upload-marketing-media.ts",
    "smoke": "node scripts/smoke/run.mjs",
    "seed:staging": "node scripts/seed-staging.mjs",
    "rework:verify": "node scripts/rework/verify-evidence.mjs",
    "rework:capture": "node scripts/rework/capture.mjs",
    "e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "next": {
      "postcss": "^8.5.26"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@netlify/functions": "^5.3.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@phosphor-icons/react": "2.1.10",
    "@prisma/client": "^5.19.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@sentry/nextjs": "^10.76.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "disposable-email-domains": "1.0.62",
    "framer-motion": "^11.3.0",
    "frimousse": "^0.4.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "libphonenumber-js": "1.13.15",
    "next": "^15.5.28",
    "next-auth": "^4.24.15",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^9.2.1",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "sileo": "0.1.6",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@playwright/test": "^1.65.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.25",
    "prisma": "^5.19.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  }
