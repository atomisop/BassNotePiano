// ============================================================================
// Bass Note Piano — Prisma schema
// PostgreSQL (Neon in production, any Postgres locally). Covers auth
// (NextAuth adapter), the six-scale curriculum, per-user progress gating,
// and manual Zelle payment verification for the one-time $69.99 curriculum
// purchase and $34.99/30-minute live lesson add-ons.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's PgBouncer endpoint in production) — used for
  // every query the running app makes.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`. PgBouncer's
  // transaction-mode pooling doesn't support the session-level features
  // migrations need, so this has to bypass the pooler. Locally, where
  // there's no pooler, both vars just point at the same database.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum ProgressStatus {
  LOCKED // previous scale not yet completed
  AVAILABLE // unlocked (paid or Pro) but not started
  IN_PROGRESS // module read and/or practice logged, quiz not yet passed
  COMPLETED // checklist fully cleared: read + practice + quiz passed
}

enum PaymentPurpose {
  CURRICULUM // one-time $69.99 full-curriculum unlock (renamed from PRO_LIFETIME)
  SCALE_UNLOCK // legacy Pay-As-You-Go per-scale unlock — no longer purchasable, kept for historical rows
  CLASS_CREDITS // class-credit bundle purchase (renamed from LESSON_PACKAGE — the old 1:1 online/in-person lesson system was replaced by the weekly group-class schedule below)
  FAMILY_BUNDLE // one credit tier bought for 2+ separate, already-existing accounts at once, an extra 10% off the combined price (FAMILY_BUNDLE_DISCOUNT_RATE in classCreditPricing.ts). See FamilyBundleRecipient below for who actually receives the credits
  PAYMENT_PLAN_INSTALLMENT // one monthly installment of a PaymentPlan term commitment — same AWAITING_TRANSFER/PENDING_REVIEW/VERIFIED lifecycle as any other purchase, see PaymentPlan below
  // Same shape as FAMILY_BUNDLE but for curriculum access instead of class
  // credits, 2+ separate, already-existing accounts unlocking the full
  // curriculum in one purchase, 20% off the combined price
  // (CURRICULUM_FAMILY_BUNDLE_DISCOUNT_RATE in curriculum.ts). Also uses
  // FamilyBundleRecipient below, with creditsGranted always 0 there (a
  // curriculum grant isn't a credit count, that field just goes unused for
  // this purpose); approveZellePayment's own branch keys off payment.purpose,
  // not that field, to decide what each recipient actually receives.
  CURRICULUM_FAMILY_BUNDLE
}

// A student's standing commitment to pay for class credits in periodic
// monthly installments over a locked term (3/6/12 months), at that term's
// discounted rate — Zelle only, no auto-billing, ever. This model is the
// commitment itself (cadence, term, locked rate, progress); it never moves
// money on its own — each individual installment's actual payment is an
// ordinary ZellePayment row (purpose PAYMENT_PLAN_INSTALLMENT, paymentPlanId
// pointing back here), going through the exact same AWAITING_TRANSFER ->
// PENDING_REVIEW -> VERIFIED/REJECTED lifecycle, and the exact same
// /admin/payments queue, as any other purchase — see approveZellePayment's
// PAYMENT_PLAN_INSTALLMENT branch in payments.ts.
//
// installmentAmountCents/creditsPerInstallment/termMonths are snapshotted at
// enrollment from calculatePaymentPlanRate() and never recomputed later, even
// if the pricing ladder itself changes — unlike a one-time ZellePayment (a
// single frozen amountCents is enough), a plan's locked-rate promise has to
// survive many future installment-creation events over up to a year, so
// every number that promise depends on is frozen here.
//
// No stored "overdue" status: derived at read time as
// `status == ACTIVE && nextDueDate < now`, since nothing needs to notice the
// date passed and flip a flag — same "the fewest moving parts that can't
// drift" reasoning as the rest of this app's status handling.
//
// reservedScheduleId/reservedChunkIndex: the plan's own weekly day/time,
// exclusively theirs for as long as the plan (or its final still-live
// CreditGrant) stays active — see src/lib/classSchedule.ts's
// getReservableSlots/createReservedBookingIfAbsent and the daily
// netlify/functions/payment-plan-reservations.ts job that keeps a rolling
// window of real ClassBooking rows booked against it. Null only for a
// hypothetical plan enrolled before this existed; every new enrollment sets
// both. reservedSlotInactiveNotifiedAt guards the one-time "your slot isn't
// offered anymore" notice if an admin deactivates the underlying schedule —
// reset to null if it's reactivated, so a later deactivation can notify
// again.
model PaymentPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PaymentPlanStudent", fields: [userId], references: [id], onDelete: Cascade)

  cadence PaymentPlanCadence
  term    PaymentPlanTerm

  installmentAmountCents Int
  creditsPerInstallment  Int
  termMonths             Int

  installmentsPaid Int               @default(0)
  // Anchored to the ORIGINAL schedule and advanced from its own prior value
  // on each approval, never from the approval date itself — a late payment
  // shows up as late next time, it doesn't quietly reset the clock. Also
  // doubles as the paid-cycle boundary: the CreditGrant created by that same
  // approval expires at exactly this new value (see payments.ts).
  nextDueDate      DateTime
  status           PaymentPlanStatus @default(ACTIVE)

  reservedScheduleId             String?
  reservedSchedule               ClassSchedule? @relation(fields: [reservedScheduleId], references: [id])
  reservedChunkIndex             Int?
  reservedSlotInactiveNotifiedAt DateTime?

  canceledAt       DateTime?
  canceledById     String?
  canceledBy       User?     @relation("PaymentPlanCanceledBy", fields: [canceledById], references: [id])
  cancellationNote String?

  // Only set when the student canceled this themselves (see
  // cancelPaymentPlanBySelf in paymentPlans.ts), never on an admin
  // cancellation, cancellationNote above stays the admin-only field it
  // always was. Null reason means either still ACTIVE, or an admin
  // cancellation with no structured reason attached. cancellationReasonNote
  // is required when reason is OTHER, optional free-text alongside any
  // other preset reason.
  cancellationReason     PlanCancellationReason?
  cancellationReasonNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  installmentPayments ZellePayment[]
  creditGrants        CreditGrant[]
  reservedBookings    ClassBooking[]

  @@index([userId])
  @@index([status, nextDueDate])
  @@index([reservedScheduleId, reservedChunkIndex, status])
}

// 4 or 8 credits per monthly installment (30 or 60 min/week), matching
// SOLO_MAX_CREDITS in classSchedule.ts, and also 1 or 2 credits/week (see
// PLAN_CADENCE_CREDITS_PER_WEEK in classCreditPricing.ts) — what the plan's
// reserved weekly slot (PaymentPlan.reservedScheduleId/reservedChunkIndex)
// costs to auto-book each week.
enum PaymentPlanCadence {
  MIN_30_WEEKLY
  MIN_60_WEEKLY
}

// How many monthly installments are locked in at enrollment, and which
// discount tier that unlocks (0% / 10% / 20% / 30% off) — see
// calculatePaymentPlanRate in classCreditPricing.ts. MONTHLY (termMonths=1,
// 0% off) is the no-commitment tier: the old a-la-carte individual purchase
// flow at /billing/lessons was fully removed once this existed, so this is
// now the only way to buy solo class credits without a multi-month term. A
// MONTHLY plan completes (and needs re-enrolling) after its one installment
// clears, same completion logic as any other term.
enum PaymentPlanTerm {
  MONTHLY
  TERM_3
  TERM_6
  TERM_12
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

// The 8 premade options a student picks from when self-canceling a Payment
// Plan on /account (see cancelPaymentPlanBySelf in paymentPlans.ts), plus
// OTHER as the 9th, freeform via cancellationReasonNote. Read by admins on
// /admin/feedback. Order here is display order in the picker.
enum PlanCancellationReason {
  TOO_EXPENSIVE
  NOT_ENOUGH_TIME
  SCHEDULE_CONFLICT
  TAKING_A_BREAK
  SWITCHING_TEACHER
  NOT_SATISFIED
  GOALS_ACHIEVED
  TECHNICAL_ISSUES
  OTHER
}

// Secondary bookkeeping only — never a replacement for User.classCredits,
// which stays the fast, authoritative balance every existing reader keeps
// using unchanged. This table exists purely to answer "which batch of
// credits is this, where did it come from, when does it lapse" — see
// src/lib/creditLedger.ts's grantCredits/drawDownCredits/
// expireDueCreditGrants, all best-effort against this table (never allowed
// to block or fail the real User.classCredits mutation they run alongside).
// Only PAYMENT_PLAN_INSTALLMENT grants ever carry a real expiresAt — a
// Payment Plan credit is good for the ~month the installment paid for, per
// direct instruction; every other source (Family bundle, legacy a-la-carte,
// admin grants, and the one-time PRE_LEDGER_BALANCE backfill below) stays
// genuinely non-expiring, expiresAt null.
enum CreditGrantSource {
  PAYMENT_PLAN_INSTALLMENT
  FAMILY_BUNDLE
  CLASS_CREDITS
  ADMIN_ADJUSTMENT
  PRE_LEDGER_BALANCE // one-time migration backfill for balances that predate this table — see that migration's data backfill
}

model CreditGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source CreditGrantSource

  // Only set for source == PAYMENT_PLAN_INSTALLMENT — links this grant back
  // to the plan whose reservation it's keeping alive (see PaymentPlan's own
  // "COMPLETED with a live grant still counts" reservation-maintenance
  // logic). No onDelete keyword (defaults to SetNull): a grant row is a
  // historical/audit record and should outlive its plan if the plan row
  // itself is ever removed.
  paymentPlanId String?
  paymentPlan   PaymentPlan? @relation(fields: [paymentPlanId], references: [id])

  creditsGranted         Int
  // Drawn down by drawDownCredits as the student actually spends credits
  // (soonest-expiring grants first) and by expireDueCreditGrants once
  // expiresAt passes. Best-effort: this can drift from the truth
  // (User.classCredits) under concurrent activity, and that's an accepted,
  // bounded trade-off — see creditLedger.ts's own comment.
  creditsRemaining       Int
  expiresAt              DateTime?
  // Stamped once expireDueCreditGrants has processed this row, so a repeat
  // sweep run never double-decrements it.
  expiredAt              DateTime?
  // Stamped once warnExpiringSoonCreditGrants has sent the student a
  // heads-up that this grant is about to lapse, so a repeat daily run
  // never re-sends it. Never reset: expiresAt itself is immutable once a
  // grant is created (each installment approval creates its own new grant
  // rather than ever updating an existing one's expiresAt), so a grant's
  // warning is a one-time event, not a recurring toggle the way a
  // schedule's active flag is.
  expiringSoonNotifiedAt DateTime?

  grantedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, creditsRemaining])
  @@index([expiresAt])
  @@index([paymentPlanId])
}

// Kept only for LessonType/LessonBooking below, which are now historical —
// the 1:1 online/in-person lesson system was replaced by the weekly
// group-class schedule (see ClassSchedule/ClassBooking).
enum LessonType {
  ONLINE
  IN_PERSON
}

// Admin-uploaded course content, distinct from LessonType/LessonBooking
// above (those are the live-coaching booking system — different feature
// entirely). "Lesson" here means a video or PDF module inside a scale
// group's course player.
enum LessonMediaType {
  VIDEO
  PDF
}

enum LessonBookingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum ZellePaymentStatus {
  AWAITING_TRANSFER // modal opened, instructions shown, user hasn't submitted a reference yet
  PENDING_REVIEW // user submitted a reference code; awaiting manual/automated verification
  VERIFIED // confirmed — entitlement granted
  REJECTED // reference could not be matched / invalid — user must resubmit
  EXPIRED // left unconfirmed past the review window, auto-closed
}

enum QuizResult {
  PASSED
  FAILED
}

enum VerificationPurpose {
  EMAIL_VERIFY // confirm the address at signup
  LOGIN_2FA // 6-digit code required on every login
  PASSWORD_RESET // forgot-password flow
  CHANGE_PASSWORD // confirm a password change from account settings
  CHANGE_NAME // confirm a display name change
  CHANGE_AVATAR // confirm a profile photo change
  DELETE_ACCOUNT // confirm permanent account deletion from account settings — unlike CHANGE_*, still code-gated (see the 2026-08-07 decision note in account/actions.ts): deleting is irreversible, so it keeps the extra step the others dropped
}

// ---------------------------------------------------------------------------
// Onboarding — collected once, right after signup; editable later in Settings
// ---------------------------------------------------------------------------

enum PrimaryInstrument {
  PIANO_KEYBOARD
  BASS
  GUITAR
  DRUMS
  VOCAL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MusicGenre {
  JAZZ
  CLASSICAL
  RNB
  ROCK
  POP
  GOSPEL
}

enum LearningGoal {
  LEARN_THEORY_SCALES
  MASTER_RHYTHM_CHORDS
  PREPARE_PERFORMANCE
  HOBBYIST
}

// ---------------------------------------------------------------------------
// Gamification — badges and practice streaks
// ---------------------------------------------------------------------------

// Fixed, code-defined set (see src/lib/badges.ts for label/description/
// unlock copy) — not admin-editable content, so no separate Badge table.
enum BadgeCode {
  FIRST_LESSON_DONE
  SCALE_MASTER
  RHYTHM_SPECIALIST
  CHORD_MAESTRO
  COURSE_GRADUATE
  FIRST_FRIEND_ADDED // awarded once the friends system (later step) exists
  COMMUNITY_CATALYST // 5+ friends — same dependency
  ACTIVE_PRACTICE_PARTNER // same dependency
  STREAK_3_DAY
  STREAK_7_DAY
  STREAK_30_DAY
}

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     BadgeCode
  earnedAt DateTime  @default(now())

  @@unique([userId, code])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ROLE_UPDATED
  FRIEND_REQUEST_RECEIVED // awaiting the friends system (later step)
  FRIEND_REQUEST_ACCEPTED // same dependency
  NEW_MESSAGE // same dependency
  PRACTICE_REMINDER
  CLASS_REGISTRATION_RECEIVED // to admins, when someone submits the public class registration form
  CLASS_REGISTRATION_APPROVED // to the registrant, if they have an account
  CLASS_REGISTRATION_REJECTED // same
  LESSON_BOOKING_RECEIVED // to admins, when a student books a live lesson using a credit
  LESSON_BOOKING_CANCELED // to the student, when a booking is canceled and their credit is refunded
  ANNOUNCEMENT // fanned out to every user when an admin publishes an announcement
  CREDIT_ADJUSTED // to the student, when an admin manually grants or deducts class credits
  ASSISTANT_ESCALATION // to admins, when a visitor asks the Atom widget to connect them to a person
  PAYMENT_PLAN_INSTALLMENT_DUE // to the student, when the next installment of their PaymentPlan opens for payment
  PAYMENT_PLAN_INSTALLMENT_OVERDUE // to the student, escalating reminder while an installment stays unpaid past its due date
  PAYMENT_PLAN_COMPLETED // to the student, when their final installment is verified and the plan is fully paid off
  PAYMENT_PLAN_CANCELED // to the student, when their plan is canceled, by an admin or by themselves
  CREDITS_EXPIRED // to the student, when unused Payment Plan credits lapse at the end of their paid cycle
  CREDITS_EXPIRING_SOON // to the student, a few days ahead of CREDITS_EXPIRED, while there's still time to use them
  RESERVED_SLOT_UNAVAILABLE // to the student, when an admin deactivates the weekly schedule their Payment Plan reserves
  PLAN_CANCELLATION_FEEDBACK // to admins, when a student self-cancels their Payment Plan and leaves a reason, see /admin/feedback
  CURRICULUM_ACCESS_GRANTED // to a curriculum family bundle recipient who wasn't the buyer. PAYMENT_APPROVED's own CTA points at /billing/history, empty for a recipient who never paid, this points at the roadmap they can now actually use
  RESERVED_SLOT_CHANGED // to the student, when they self-serve move their Payment Plan's standing weekly slot to a different day/time
  CURRICULUM_ACCESS_REVOKED // to the student, when an admin manually removes curriculum access outside the normal payment flow
}

// The in-app inbox is the source of truth — always written regardless of
// preference. The four notifyEmail* booleans on User only control whether a
// given category *also* sends an email, same pattern as most apps' "also
// notify me by email" toggle rather than a full per-channel opt-out.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Admin-authored broadcast, shown to every signed-in user until they
// dismiss it (swipeable banner/popup) — separate from the per-user
// Notification fan-out below, which is the bell-entry copy of the same
// announcement and has its own independent read/unread state.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdBy String
  admin     User     @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  dismissals AnnouncementDismissal[]

  @@index([active, createdAt])
}

// One row per user who has swiped away / closed a given announcement's
// banner — the absence of a row is what keeps it showing. Separate from
// Notification.readAt (the bell entry), which tracks independently.
model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AnnouncementDismissedBy", fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
}

// ---------------------------------------------------------------------------
// Class registration — public lead-capture form, no account required
// ---------------------------------------------------------------------------

enum ClassRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Deliberately not tied to an account — the public form works for visitors
// who don't have (or don't yet want) a platform login. userId is filled in
// opportunistically when the submitter happens to be signed in, purely so
// an approval can also raise an in-app Notification for them; email is the
// one contact channel guaranteed to exist for every registrant.
model ClassRegistration {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("ClassRegistrant", fields: [userId], references: [id], onDelete: SetNull)

  fullName   String
  email      String
  phone      String
  instrument PrimaryInstrument
  skillLevel SkillLevel
  notes      String?           @db.Text

  status ClassRegistrationStatus @default(PENDING)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ClassRegistrationReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Social — friends and 1-on-1 direct messages
// ---------------------------------------------------------------------------

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A friendship isn't a separate model — "are these two users friends" is
// just "does an ACCEPTED request exist between them, in either direction."
// Keeps the historical request itself (who asked whom, when) as the single
// record rather than duplicating it into a second table on acceptance.
model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  sender      User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

// One-directional — A blocking B doesn't block B from A's perspective in
// reverse, but sendFriendRequest/sendMessage check both directions before
// allowing contact, so a block is effective regardless of who initiated it.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// 1-on-1 only, no group threads — "conversations" are derived at query time
// (distinct counterpart + latest message), not a separate Conversation
// model, since there's nothing a thread record would own beyond that.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  // Swipe-to-reply, set at send time, never changed after. onDelete: SetNull
  // (not Cascade) so deleting the original message just orphans the quoted
  // reply into a plain message instead of taking a whole reply chain down
  // with it. There's no message-delete feature today, but nothing here
  // should assume there never will be.
  replyToId String?
  replyTo   Message?          @relation("MessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[]         @relation("MessageReplyTo")
  reactions MessageReaction[]

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt])
  @@index([replyToId])
}

// One reaction per (message, user), like iMessage's own Tapback: picking a
// different emoji replaces your previous one rather than stacking a second
// row, and the same unique constraint is what makes "upsert" the right
// write for reactToMessage regardless of whether this is a first reaction
// or a change.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// A conversation "pinned" to the top of a user's own Messages sidebar —
// per-user, not mutual, so pinning a friend doesn't pin you on their side.
model PinnedConversation {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("PinnedByUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("PinnedFriend", fields: [friendId], references: [id], onDelete: Cascade)
  pinOrder Int

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId, pinOrder])
}

// One row per (sender, recipient) pair, upserted on every debounced
// keystroke in the composer. Freshness (updatedAt within the last few
// seconds), not a boolean, is what the recipient's poll checks — there's no
// "stopped typing" write, it just goes stale. Cleared explicitly on send so
// the indicator doesn't linger for the full staleness window.
model TypingStatus {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("TypingStatusSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("TypingStatusRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([senderId, recipientId])
  @@index([recipientId, updatedAt])
}

// Group chat — additive alongside the 1-on-1 Message model above, not a
// replacement. Membership is friends-only at creation time (same trust
// boundary as 1-on-1 messaging); there's no post-creation invite/kick, only
// leaving, which keeps the moderation surface small for a first version.
model GroupConversation {
  id          String   @id @default(cuid())
  name        String? // optional — the UI falls back to listing member names
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
  typing   GroupTypingStatus[]
}

// Who is typing in a group right now. Same idea as TypingStatus for 1-on-1:
// recency is the signal (a row older than a few seconds is ignored), and the
// writer re-pings while their keyboard is open. One row per (group, person).
model GroupTypingStatus {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("GroupTypingUser", fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime          @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId, updatedAt])
}

// unreadCount is derived at query time from lastReadAt rather than a
// per-message read receipt row — there's no need to know exactly which
// message a member has seen, just "how many landed since they last looked."
model GroupMember {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime          @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model GroupMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String            @db.Text
  createdAt      DateTime          @default(now())

  // Same shape as Message's own replyToId/reactions above, see those
  // comments.
  replyToId String?
  replyTo   GroupMessage?          @relation("GroupMessageReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   GroupMessage[]         @relation("GroupMessageReplyTo")
  reactions GroupMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

// Same shape as MessageReaction above, for GroupMessage.
model GroupMessageReaction {
  id        String       @id @default(cuid())
  messageId String
  message   GroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("GroupMessageReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js Prisma adapter shape)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set only for credentials-based signup
  role          Role      @default(STUDENT)

  // Bumped by a password change or an explicit "sign out of all other
  // devices" (see src/lib/auth.ts's jwt callback and
  // signOutOtherDevicesAction in the account actions). Every other
  // already-open session is carrying an older value baked into its own JWT
  // at sign-in, so a mismatch here is what actually invalidates it — the
  // account-settings password form's claim that changing it signs out other
  // devices did nothing enforceable before this existed.
  sessionVersion Int @default(1)

  // Optional — nothing in the app requires it except the friends/messages
  // system, which prompts for it inline rather than forcing it through the
  // (already-shipped) onboarding wizard. Always stored lowercase so
  // uniqueness is effectively case-insensitive without a citext extension.
  username String? @unique

  // Derived/cached entitlement flags — kept in sync whenever a ZellePayment
  // transitions to VERIFIED. Read by the NextAuth JWT callback so middleware
  // can gate routes without a DB round trip on the edge.
  //
  // As of the live-class-only model, hasCurriculumAccess is no longer set by
  // any purchase: it's the admin's complimentary override only. Real access
  // is derived from an active Payment Plan (src/lib/entitlement.ts).
  hasCurriculumAccess  Boolean   @default(false)
  curriculumUnlockedAt DateTime?

  // Set once when a class application is approved (3 days out). Never
  // cleared, so it doubles as the "already had a trial" marker: one per
  // person, not one per application.
  trialEndsAt DateTime?

  // 1 credit = 30 minutes of class, fixed regardless of which bundle it was
  // bought in — bundling only discounts the price paid, never the time
  // value. Spent from /lessons when booking a weekly group-class occurrence
  // (creditCost per ClassSchedule row), refunded on a >=24h-ahead
  // cancellation, forfeited on a late cancellation or a marked no-show.
  // Incremented on approval of a CLASS_CREDITS ZellePayment (see
  // approveZellePayment). Replaces the old online/in-person split — the
  // new weekly schedule is Zoom-only, one unified pool.
  classCredits Int @default(0)

  // Collected once by the mandatory post-registration wizard (middleware
  // redirects any signed-in-but-unonboarded user there). onboardedAt null
  // is the "must complete the wizard" signal; everything else is optional
  // even after that, since none of it gates access to anything.
  primaryInstrument PrimaryInstrument?
  skillLevel        SkillLevel?
  genres            MusicGenre[]       @default([])
  learningGoal      LearningGoal?
  onboardedAt       DateTime?

  // A day counts once (max) toward the streak the first time any practice
  // action (module read, practice logged, quiz attempted) happens that
  // calendar day — see recordPracticeActivity() in src/lib/gamification.ts.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  // Per-category "also email me" toggles for the in-app notification
  // center — reminders default off since they're the closest thing to
  // marketing email here, unlike the other three which are transactional.
  notifyEmailPayments    Boolean @default(true)
  notifyEmailRoleUpdates Boolean @default(true)
  notifyEmailSocial      Boolean @default(true)
  notifyEmailReminders   Boolean @default(false)

  // Drives the "What's new" popup — shown once per calendar day (compared
  // in UTC) the first time a signed-in user hits any dashboard page, not on
  // every login. Null means "never seen one," which also shows it.
  lastSeenPatchNotesAt DateTime?

  // Drives the interactive spotlight walkthrough — shown automatically
  // exactly once (right after onboarding wizard + first login), never
  // again on its own after that. Null means "never seen it." Replayable
  // anytime from Settings → Tutorials, which doesn't touch this column —
  // only the automatic one-time trigger reads it.
  onboardingTourSeenAt DateTime?

  // How many times this account has explicitly dismissed Atom's own
  // greeting bubble (the X control on "Hi, I'm Atom..."; see
  // AssistantWidget's dismissGreeting()). Opening the chat instead of
  // dismissing it doesn't increment this: using Atom is already a
  // stronger signal than closing an unread pitch. Once this reaches the
  // limit defined alongside dismissGreeting(), the bubble stops appearing
  // at all, on any device, forever. An anonymous visitor has no account to
  // persist this on, so they get the same cap enforced from a localStorage
  // counter on their own browser instead (see AssistantWidget.tsx).
  atomGreetingDismissCount Int @default(0)

  accounts Account[]
  sessions Session[]

  notifications Notification[]

  announcementsCreated   Announcement[]          @relation("AnnouncementAuthor")
  announcementDismissals AnnouncementDismissal[] @relation("AnnouncementDismissedBy")

  progress         ScaleProgress[]
  quizAttempts     QuizAttempt[]
  zellePayments    ZellePayment[]  @relation("PaymentSubmitter")
  reviewedPayments ZellePayment[]  @relation("PaymentReviewer")
  lessonBookings   LessonBooking[] @relation("LessonBookingStudent") // historical — see LessonBooking model comment
  classBookings    ClassBooking[]  @relation("ClassBookingStudent")

  paymentPlans         PaymentPlan[] @relation("PaymentPlanStudent")
  paymentPlansCanceled PaymentPlan[] @relation("PaymentPlanCanceledBy") // admin side of an admin-canceled plan

  creditGrants CreditGrant[]

  creditAdjustmentsReceived CreditAdjustment[] @relation("CreditAdjustmentRecipient")
  creditAdjustmentsGranted  CreditAdjustment[] @relation("CreditAdjustmentGrantedBy")

  uploadedLessons Lesson[]
  lessonProgress  LessonProgress[]
  scaleNotes      ScaleNote[]

  verificationCodes VerificationCode[]
  loginEvents       LoginEvent[]
  badges            UserBadge[]

  assistantFeedback            AssistantFeedback[]
  assistantEscalations         AssistantEscalation[]          @relation("AssistantEscalationSubmitter")
  assistantEscalationsResolved AssistantEscalation[]          @relation("AssistantEscalationResolver")
  supportMessagesSent          SupportMessage[]               @relation("SupportMessageSentBy")
  assistantConversation        AssistantConversationMessage[]
  familyBundlesReceived        FamilyBundleRecipient[]

  sentFriendRequests     FriendRequest[]      @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]      @relation("FriendRequestReceiver")
  blocksMade             Block[]              @relation("BlockedBy")
  blocksReceived         Block[]              @relation("BlockedUser")
  messagesSent           Message[]            @relation("MessageSender")
  messagesReceived       Message[]            @relation("MessageRecipient")
  messageReactions       MessageReaction[]    @relation("MessageReactionUser")
  pinnedByMe             PinnedConversation[] @relation("PinnedByUser")
  pinnedByOthers         PinnedConversation[] @relation("PinnedFriend")
  typingStatusesSent     TypingStatus[]       @relation("TypingStatusSender")
  typingStatusesReceived TypingStatus[]       @relation("TypingStatusRecipient")

  classRegistrations         ClassRegistration[] @relation("ClassRegistrant")
  reviewedClassRegistrations ClassRegistration[] @relation("ClassRegistrationReviewer")

  createdGroups         GroupConversation[]    @relation("GroupCreator")
  groupMemberships      GroupMember[]          @relation("GroupMembership")
  groupTypingStatuses   GroupTypingStatus[]    @relation("GroupTypingUser")
  groupMessagesSent     GroupMessage[]         @relation("GroupMessageSender")
  groupMessageReactions GroupMessageReaction[] @relation("GroupMessageReactionUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Security — email verification codes, 2FA, login history
// ---------------------------------------------------------------------------

// A single-use 6-digit code emailed for any sensitive action. Codes are
// hashed at rest (never store the raw digits) and scoped to one purpose, so
// a leaked LOGIN_2FA code can't be replayed against, say, CHANGE_PASSWORD.
// `payload` carries the pending value for CHANGE_* purposes (the new name,
// the new password hash, the new avatar data URI) — the change is only
// ever applied once the matching code is confirmed, never before.
model VerificationCode {
  id      String              @id @default(cuid())
  userId  String?
  email   String // the address the code was actually sent to
  purpose VerificationPurpose

  codeHash   String
  payload    Json?
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

// One row per successful login — what new-location detection compares
// against, and eventually a place a student could review their own account
// activity from.
model LoginEvent {
  id            String  @id @default(cuid())
  userId        String
  ip            String?
  city          String?
  region        String?
  country       String?
  userAgent     String?
  isNewLocation Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One row per failed login attempt (wrong password OR an email with no
// account at all — recorded the same way so both paths carry the same
// cost to an attacker). Not tied to User by a required relation: a guess
// against a nonexistent email still needs to count against something, so
// this is keyed on the submitted email string directly, not a userId.
//
// Existence of this table is the whole fix for STEP 26's "no lockout on
// repeated wrong-password attempts" finding — loginStepOneAction in
// login/actions.ts checks assertRateLimit against it before ever touching
// bcrypt, and writes a row here on every failure. Rows are never deleted
// on success; the sliding time window (see assertRateLimit) is what lets a
// legitimate user recover, not a manual reset.
model FailedLoginAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// Rate-limit ledger for checkFamilyBundleRecipientsAction (billing/lessons).
// That action reveals, per email a signed-in buyer types in, whether it
// belongs to a real account. That's a deliberate, narrow account-enumeration
// surface (the whole feature needs it: a parent has to find out which
// kid's email was mistyped before paying), so the trade-off made here is
// requiring a real signed-in session to even reach it (no anonymous mass
// probing) plus this table capping how many lookups any one account can
// run, rather than trying to hide which emails exist at all.
model FamilyBundleCheckAttempt {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Rate-limit ledger for the Atom assistant widget (src/lib/assistant.ts) —
// every real reply costs a paid Anthropic API call, and the widget is
// reachable from the public marketing pages with no login required, so this
// exists purely to bound cost/abuse. `identifier` is `user:<id>` for a
// signed-in visitor or the request's IP address for an anonymous one — never
// both, never anything else. Not a conversation log: no message content is
// stored here, only "this identifier made a request at this time."
model AssistantRateLimit {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

// Per direct instruction: an anonymous visitor's plain Atom chat (as
// opposed to an actual support handoff, which already persists as an
// AssistantEscalation/SupportMessage pair above) is never written here at
// all. It lives only in the widget's own React state, gone the moment the
// tab reloads. Only a SIGNED-IN visitor's Atom conversation is kept, tied to
// their account, so it survives a reload/new device/logging back in later.
// This is the one place that's true, deliberately smaller in scope than
// the studio's overall notion of "chat history," and specifically so
// anonymous traffic can't grow this table unbounded.
//
// Deletion is admin-only (see clearAssistantHistoryAction in
// admin/users/actions.ts). There's no self-service "clear my chat" for the
// student themselves, only for the studio to prune on request.
model AssistantConversationMessage {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AssistantMessageRole
  content   String               @db.Text
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
}

enum AssistantFeedbackRating {
  UP
  DOWN
}

// One row per thumbs up/down click on a single Atom reply — the small,
// low-friction rating shown under each assistant bubble in the widget.
// `identifier` follows the exact same `user:<id>` / IP convention as
// AssistantRateLimit above, purely to rate-limit the endpoint; `userId` is
// the separate, nullable link to a real account for whoever happens to be
// signed in when they rate a reply, so the studio can tell "who" apart from
// "how many" if it ever matters. Not tied to a stored conversation — Atom
// keeps no server-side chat log outside of an actual escalation (see
// AssistantEscalation below), so this is just "this reply text got this
// rating, from this identifier, at this time."
model AssistantFeedback {
  id             String                  @id @default(cuid())
  identifier     String
  userId         String?
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating         AssistantFeedbackRating
  messageContent String                  @db.Text
  createdAt      DateTime                @default(now())

  @@index([identifier, createdAt])
  @@index([userId])
}

enum AssistantEscalationStatus {
  OPEN
  RESOLVED
}

// A "connect me to a person" handoff from the Atom widget's guided triage:
// created once the visitor confirms they want a human, after Atom couldn't
// resolve it on its own. This is the live support thread's parent row — the
// one place Atom's conversation is actually persisted server-side, since an
// anonymous visitor (the widget works with no account) has no Message
// history to point at at all. Notifying admins on creation (see
// createAssistantEscalation in src/lib/assistantEscalation.ts) is what
// leads an admin to /admin/support to pick it up.
model AssistantEscalation {
  id              String                    @id @default(cuid())
  identifier      String
  userId          String?
  user            User?                     @relation("AssistantEscalationSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  contactName     String?
  contactEmail    String
  status          AssistantEscalationStatus @default(OPEN)
  // Bumped every time any admin opens this thread in /admin/support — a
  // single shared "last read" rather than per-admin, same collective-inbox
  // model messages.ts already uses for admin threads. Drives the unread dot
  // in the thread list: any SupportMessage(sender: VISITOR) newer than this
  // is unread. Null means "never opened."
  adminLastReadAt DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?                     @relation("AssistantEscalationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                  @default(now())

  messages SupportMessage[]

  @@index([status, createdAt])
  @@index([identifier, createdAt])
}

enum SupportMessageSender {
  VISITOR // the person who escalated — signed-in user or anonymous visitor
  ATOM // replayed from the pre-escalation AI chat, seeded once at handoff time so the thread is one continuous timeline
  SUPPORT // an admin reply — always shown to the visitor as "Support", never by name (see sentById below)
}

// One row per message in a support thread, from the pre-escalation Atom
// history through the live back-and-forth after handoff — the whole
// conversation is just this table's rows in order, so the widget and the
// admin panel both render off the exact same source. `sentById` records
// which admin actually typed a SUPPORT reply, but is internal-only: no
// visitor-facing API response includes it — the widget only ever sees the
// generic "Support" role, which is the whole point (no personal admin
// identity leaks to a visitor).
model SupportMessage {
  id           String               @id @default(cuid())
  escalationId String
  escalation   AssistantEscalation  @relation(fields: [escalationId], references: [id], onDelete: Cascade)
  sender       SupportMessageSender
  body         String               @db.Text
  // Same `user:<id>` / IP convention as elsewhere — set only on VISITOR rows, for rate-limiting/abuse trail only.
  identifier   String?
  sentById     String?
  sentBy       User?                @relation("SupportMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([escalationId, createdAt])
}

// ---------------------------------------------------------------------------
// Curriculum
// ---------------------------------------------------------------------------

// One row per book scale group (Scale 0 ... Scale 5). Seeded once from the
// curriculum book — see prisma/seed.ts.
model ScaleGroup {
  id          String  @id @default(cuid())
  slug        String  @unique // "scale-0" .. "scale-5"
  order       Int     @unique // 0-5, defines the required sequencing
  code        String // "Scale 3"
  title       String // "Bati — Major, Minor & Lydian"
  kinitName   String? // "Bati Minor", "Tizita Major (Full Tizita)", etc.
  formula     String // degree formula, e.g. "1-b3-4-5-b7"
  description String? @db.Text

  // Vestigial — Pay-As-You-Go per-scale pricing was retired in favor of a
  // single $69.99 curriculum purchase (see CURRICULUM_PRICE_CENTS in
  // src/lib/curriculum.ts). Left in place rather than migrated away since
  // nothing reads it anymore; not worth a destructive column drop for it.
  priceCents Int @default(2500)

  progress      ScaleProgress[]
  quizAttempts  QuizAttempt[]
  zellePayments ZellePayment[]
  lessons       Lesson[]
  notes         ScaleNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-authored course content (video or PDF) for one scale group's course
// player. Ordered, sequentially gated in the UI (src/lib/courseContent.ts /
// the /scales/[scaleSlug] course player) — not the same thing as
// LessonBooking above (that's a student booking live 1:1 time with the
// admin; this is pre-recorded/uploaded module content).
model Lesson {
  id              String          @id @default(cuid())
  scaleGroupId    String
  scaleGroup      ScaleGroup      @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  description     String?
  type            LessonMediaType
  fileUrl         String
  fileName        String
  fileSizeBytes   BigInt?
  durationSeconds Int? // video only, read from the file client-side on upload; left null for PDFs
  uploadedById    String
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  progress LessonProgress[]

  @@unique([scaleGroupId, order])
  @@index([scaleGroupId])
}

// Per-user completion of one Lesson — separate from ScaleProgress's
// moduleRead/practiceCompleted/quizPassed checklist so lesson-by-lesson
// tracking doesn't collide with it. Once every Lesson for a scale group has
// a row here for a given user, that's treated as equivalent to moduleRead
// (see syncLessonCompletionToModuleRead in src/lib/access.ts).
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId])
}

// Per-user, per-scale checklist + gating state.
model ScaleProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleGroupId String
  scaleGroup   ScaleGroup @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)

  status ProgressStatus @default(LOCKED)

  // (a) instructional module marked as read
  moduleRead   Boolean   @default(false)
  moduleReadAt DateTime?

  // (b) practical review completed
  practiceCompleted   Boolean   @default(false)
  practiceCompletedAt DateTime?

  // (c) conceptual/scale-spelling quiz passed
  quizPassed   Boolean   @default(false)
  quizScore    Int?
  quizPassedAt DateTime?

  unlockedAt  DateTime? // when access was granted (Pro purchase, Zelle verification, or override)
  completedAt DateTime? // when all three checklist items were satisfied

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scaleGroupId])
  @@index([userId, status])
}

// A student's own private notes for one scale, written from the lesson
// page's Notes tool. One note per student per scale, autosaved. Visible only
// to its author (never to admins in the UI) and deleted with the account.
model ScaleNote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleGroupId String
  scaleGroup   ScaleGroup @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)

  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scaleGroupId])
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleGroupId String
  scaleGroup   ScaleGroup @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)

  score          Int
  totalQuestions Int
  result         QuizResult
  answers        Json // [{ questionId, selected, correct }]

  attemptedAt DateTime @default(now())

  @@index([userId, scaleGroupId])
}

// ---------------------------------------------------------------------------
// Commerce — Zelle manual verification
// ---------------------------------------------------------------------------

// Every Zelle transfer the platform expects to receive: the $69.99 curriculum
// purchase, a lesson-credit package, or (historically) a $25 per-scale
// unlock. This is the row the admin verification queue and the
// ZellePaymentModal both read/write.
model ZellePayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PaymentSubmitter", fields: [userId], references: [id], onDelete: Cascade)

  purpose PaymentPurpose

  // Only set on legacy rows where purpose == SCALE_UNLOCK
  scaleGroupId String?
  scaleGroup   ScaleGroup? @relation(fields: [scaleGroupId], references: [id])

  // Only set when purpose == LESSON_PACKAGE — the discount (if any) isn't
  // stored, it's recomputed from these two at render time via
  // calculateLessonTotal() so the admin queue can show it without drift.
  lessonQuantity Int?
  lessonType     LessonType?

  // Only set when purpose == PAYMENT_PLAN_INSTALLMENT. paymentPlanId links
  // this installment's payment back to its parent commitment; no `onDelete`
  // keyword (same as scaleGroupId above) means ON DELETE SET NULL, so a
  // payment record never disappears if the plan row ever did. installmentNumber
  // is snapshotted as plan.installmentsPaid + 1 at creation time and never
  // recomputed — needed so history/admin views can still render "Installment
  // 3 of 6" correctly for an old row after the plan's own counter has moved
  // past it.
  paymentPlanId     String?
  paymentPlan       PaymentPlan? @relation(fields: [paymentPlanId], references: [id])
  installmentNumber Int?

  // Only set on a CLASS_CREDITS row created through the Schedule screen's
  // guided "buy an extra session" flow (getOrCreatePendingExtraSessionPayment
  // in payments.ts), the exact one-off occurrence the student picked before
  // paying. approveZellePayment books it directly the moment the payment
  // verifies (bookExtraSessionOccurrence in classSchedule.ts), so the student
  // never has to go spend the credit themselves at /lessons. Null for every
  // other CLASS_CREDITS row, including a legacy bare credit purchase from
  // before this flow existed.
  extraSessionScheduleId     String?
  extraSessionSchedule       ClassSchedule? @relation(fields: [extraSessionScheduleId], references: [id])
  extraSessionOccurrenceDate DateTime?
  extraSessionScheduledAt    DateTime?

  amountCents Int
  zelleHandle String // platform's receiving handle/email shown to the user at request time

  // Filled in by the student on the "I've sent it" step of the modal
  senderName    String?
  referenceCode String? // Zelle confirmation/reference number
  note          String? @db.Text
  screenshotUrl String? // optional proof-of-transfer upload

  status ZellePaymentStatus @default(AWAITING_TRANSFER)

  submittedAt DateTime? // student submitted a reference code
  reviewedAt  DateTime? // staff/automation made a decision

  reviewedById    String?
  reviewedBy      User?   @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyBundleRecipients FamilyBundleRecipient[]

  @@index([status])
  @@index([userId])
  @@index([paymentPlanId])
}

// Who actually receives credits from a FAMILY_BUNDLE ZellePayment, and how
// many. The payment's own userId is just whoever paid, which per direct
// instruction can be, but doesn't have to be, one of the recipients too.
// Written once at purchase time (see createFamilyBundlePayment in
// payments.ts, which is also where every recipient is verified to already
// hold a real, existing account — the whole point of this table existing
// separately from just trusting N raw email strings). approveZellePayment
// reads this instead of payment.userId/lessonQuantity when purpose is
// FAMILY_BUNDLE, crediting every row here rather than the payer alone.
model FamilyBundleRecipient {
  id             String       @id @default(cuid())
  paymentId      String
  payment        ZellePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditsGranted Int
  createdAt      DateTime     @default(now())

  @@unique([paymentId, userId])
  @@index([paymentId])
  @@index([userId])
}

// HISTORICAL — this 1:1 on-request lesson system (student picks any
// date/time, admin coordinates out-of-band) was replaced by the weekly
// group-class schedule below (ClassSchedule/ClassBooking). Left in place,
// unwritten-to going forward, so past bookings/payments still resolve
// correctly rather than orphaning old rows.
model LessonBooking {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation("LessonBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  type        LessonType
  scheduledAt DateTime
  meetingLink String? // filled in by the admin for ONLINE, once coordinated
  location    String? // filled in by the admin for IN_PERSON, once coordinated
  notes       String?    @db.Text

  status         LessonBookingStatus @default(SCHEDULED)
  canceledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// Weekly group classes — recurring schedule + per-occurrence bookings.
// Replaces the 1:1 on-request LessonBooking system above.
// ---------------------------------------------------------------------------

enum ClassBookingStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  NO_SHOW
}

// One row per recurring weekly slot (e.g. "Monday 11:00am ET, 2 hours") —
// the template, not any specific week's occurrence. Repeats indefinitely;
// dayOfWeek/startTime are ET wall-clock, converted to real UTC instants
// per-occurrence by src/lib/classSchedule.ts (DST-correct, not a fixed
// offset — ET oscillates between EST/EDT across the year).
model ClassSchedule {
  id          String  @id @default(cuid())
  dayOfWeek   Int // 0=Sunday..6=Saturday, matches JS Date#getDay() in ET
  startTime   String // "HH:mm" 24h, ET wall-clock
  durationMin Int
  creditCost  Int // durationMin / 30 — 1 credit = 30 min, fixed regardless of how the credit was purchased
  label       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())

  bookings             ClassBooking[]
  reservedByPlans      PaymentPlan[]
  extraSessionPayments ZellePayment[]

  @@index([dayOfWeek, active])
}

// One row per student per class occurrence. (scheduleId, occurrenceDate)
// together identify a specific week's instance of a recurring slot — that
// pair is what capacity (hard-capped at 10 SCHEDULED bookings) is counted
// against, and what the unique constraint below prevents double-booking.
model ClassBooking {
  id         String        @id @default(cuid())
  studentId  String
  student    User          @relation("ClassBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // ET calendar date (stored at UTC midnight) identifying which week's
  // occurrence this is — the capacity/uniqueness key, independent of DST.
  occurrenceDate DateTime
  // The actual UTC instant the class starts — what's shown to the student
  // (converted to their local timezone client-side) and what the 24-hour
  // cancellation cutoff and admin roster ordering are computed from.
  scheduledAt    DateTime

  // The credits this booking will cost — reserved at booking time (checked
  // against the student's own available balance) but not actually deducted
  // from User.classCredits until markAttendance runs; see that function's
  // own comment for why the charge itself waits that long. Snapshotted here
  // (not recomputed from ClassSchedule.creditCost) so a later schedule edit
  // never retroactively changes what a past booking cost.
  creditsSpent Int

  // Every row sharing one value here booked one family session together —
  // one credit charge per row, all against the same occurrence, but as one
  // booking "party" for capacity purposes (see getUpcomingOccurrences: an
  // occurrence with any active booking at all, solo or family, is full).
  // Null for a solo 1:1 booking, which needs no such grouping.
  familyBookingGroupId String?

  // Set only on a row the daily reservation job auto-created for a Payment
  // Plan's own reserved weekly slot (see PaymentPlan.reservedScheduleId) —
  // never set on a booking a student made by hand, even for that same
  // schedule/chunk. Lets cancelPaymentPlan bulk-cancel exactly its own
  // plan's future auto-bookings without touching anything else. No
  // onDelete keyword (defaults to SetNull): a booking's own history should
  // outlive the plan row if it's ever removed.
  reservedByPlanId String?
  reservedByPlan   PaymentPlan? @relation(fields: [reservedByPlanId], references: [id])

  status         ClassBookingStatus @default(SCHEDULED)
  attendance     AttendanceStatus? // set by admin after the class happens; null until marked
  // True once this booking was actually canceled before ever being charged
  // — which, now that the real charge waits for attendance, is every
  // cancellation that reaches this state at all (a booking already marked
  // COMPLETED can't be canceled — see cancelClassBooking's own guard).
  refunded       Boolean            @default(false)
  canceledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, scheduleId, occurrenceDate])
  @@index([scheduleId, occurrenceDate, status])
  @@index([studentId, status])
  @@index([familyBookingGroupId])
  @@index([reservedByPlanId])
}

// Audit trail for every manual admin change to a student's classCredits
// balance (grants, corrections, refunds outside the normal 24h-cutoff
// flow). amount is signed — positive for a grant, negative for a
// deduction — so the running total is just a sum of this table, and
// reasonNote is required at the call-site (never blank) so every entry is
// self-explanatory months later without cross-referencing anything else.
model CreditAdjustment {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation("CreditAdjustmentRecipient", fields: [userId], references: [id], onDelete: Cascade)
  adjustedById String
  adjustedBy   User   @relation("CreditAdjustmentGrantedBy", fields: [adjustedById], references: [id], onDelete: Cascade)

  amount     Int // signed: +N grants, -N deducts
  reasonNote String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Per-key request ledger for public endpoints that have no table of their
// own to count against (sign-up, the public class form). `key` is
// "<action>:<ip>" or "<action>:<email>". Rows older than a day are pruned
// opportunistically by consumeRateLimit (src/lib/rateLimit.ts).
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
