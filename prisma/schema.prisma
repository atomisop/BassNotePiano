// ============================================================================
// Bass Note Piano — Prisma schema
// PostgreSQL (Neon in production, any Postgres locally). Covers auth
// (NextAuth adapter), the six-scale curriculum, per-user progress gating,
// and manual Zelle payment verification for the one-time $99 curriculum
// purchase and $50/30-minute live lesson add-ons.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon's PgBouncer endpoint in production) — used for
  // every query the running app makes.
  url       = env("DATABASE_URL")
  // Direct, unpooled connection — used only by `prisma migrate`. PgBouncer's
  // transaction-mode pooling doesn't support the session-level features
  // migrations need, so this has to bypass the pooler. Locally, where
  // there's no pooler, both vars just point at the same database.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum ProgressStatus {
  LOCKED // previous scale not yet completed
  AVAILABLE // unlocked (paid or Pro) but not started
  IN_PROGRESS // module read and/or practice logged, quiz not yet passed
  COMPLETED // checklist fully cleared: read + practice + quiz passed
}

enum PaymentPurpose {
  CURRICULUM // one-time $99 full-curriculum unlock (renamed from PRO_LIFETIME)
  SCALE_UNLOCK // legacy Pay-As-You-Go per-scale unlock — no longer purchasable, kept for historical rows
  CLASS_CREDITS // class-credit bundle purchase (renamed from LESSON_PACKAGE — the old 1:1 online/in-person lesson system was replaced by the weekly group-class schedule below)
}

// Kept only for LessonType/LessonBooking below, which are now historical —
// the 1:1 online/in-person lesson system was replaced by the weekly
// group-class schedule (see ClassSchedule/ClassBooking).
enum LessonType {
  ONLINE
  IN_PERSON
}

// Admin-uploaded course content, distinct from LessonType/LessonBooking
// above (those are the live-coaching booking system — different feature
// entirely). "Lesson" here means a video or PDF module inside a scale
// group's course player.
enum LessonMediaType {
  VIDEO
  PDF
}

enum LessonBookingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
}

enum ZellePaymentStatus {
  AWAITING_TRANSFER // modal opened, instructions shown, user hasn't submitted a reference yet
  PENDING_REVIEW // user submitted a reference code; awaiting manual/automated verification
  VERIFIED // confirmed — entitlement granted
  REJECTED // reference could not be matched / invalid — user must resubmit
  EXPIRED // left unconfirmed past the review window, auto-closed
}

enum QuizResult {
  PASSED
  FAILED
}

enum VerificationPurpose {
  EMAIL_VERIFY // confirm the address at signup
  LOGIN_2FA // 6-digit code required on every login
  PASSWORD_RESET // forgot-password flow
  CHANGE_PASSWORD // confirm a password change from account settings
  CHANGE_NAME // confirm a display name change
  CHANGE_AVATAR // confirm a profile photo change
}

// ---------------------------------------------------------------------------
// Onboarding — collected once, right after signup; editable later in Settings
// ---------------------------------------------------------------------------

enum PrimaryInstrument {
  PIANO_KEYBOARD
  BASS
  GUITAR
  DRUMS
  VOCAL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MusicGenre {
  JAZZ
  CLASSICAL
  RNB
  ROCK
  POP
  GOSPEL
}

enum LearningGoal {
  LEARN_THEORY_SCALES
  MASTER_RHYTHM_CHORDS
  PREPARE_PERFORMANCE
  HOBBYIST
}

// ---------------------------------------------------------------------------
// Gamification — badges and practice streaks
// ---------------------------------------------------------------------------

// Fixed, code-defined set (see src/lib/badges.ts for label/description/
// unlock copy) — not admin-editable content, so no separate Badge table.
enum BadgeCode {
  FIRST_LESSON_DONE
  SCALE_MASTER
  RHYTHM_SPECIALIST
  CHORD_MAESTRO
  COURSE_GRADUATE
  FIRST_FRIEND_ADDED // awarded once the friends system (later step) exists
  COMMUNITY_CATALYST // 5+ friends — same dependency
  ACTIVE_PRACTICE_PARTNER // same dependency
  STREAK_3_DAY
  STREAK_7_DAY
  STREAK_30_DAY
}

model UserBadge {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     BadgeCode
  earnedAt DateTime  @default(now())

  @@unique([userId, code])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

enum NotificationType {
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  ROLE_UPDATED
  FRIEND_REQUEST_RECEIVED // awaiting the friends system (later step)
  FRIEND_REQUEST_ACCEPTED // same dependency
  NEW_MESSAGE // same dependency
  PRACTICE_REMINDER
  CLASS_REGISTRATION_RECEIVED // to admins, when someone submits the public class registration form
  CLASS_REGISTRATION_APPROVED // to the registrant, if they have an account
  CLASS_REGISTRATION_REJECTED // same
  LESSON_BOOKING_RECEIVED // to admins, when a student books a live lesson using a credit
  LESSON_BOOKING_CANCELED // to the student, when a booking is canceled and their credit is refunded
  ANNOUNCEMENT // fanned out to every user when an admin publishes an announcement
  CREDIT_ADJUSTED // to the student, when an admin manually grants or deducts class credits
}

// The in-app inbox is the source of truth — always written regardless of
// preference. The four notifyEmail* booleans on User only control whether a
// given category *also* sends an email, same pattern as most apps' "also
// notify me by email" toggle rather than a full per-channel opt-out.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Admin-authored broadcast, shown to every signed-in user until they
// dismiss it (swipeable banner/popup) — separate from the per-user
// Notification fan-out below, which is the bell-entry copy of the same
// announcement and has its own independent read/unread state.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdBy String
  admin     User     @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  dismissals AnnouncementDismissal[]

  @@index([active, createdAt])
}

// One row per user who has swiped away / closed a given announcement's
// banner — the absence of a row is what keeps it showing. Separate from
// Notification.readAt (the bell entry), which tracks independently.
model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("AnnouncementDismissedBy", fields: [userId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
}

// ---------------------------------------------------------------------------
// Class registration — public lead-capture form, no account required
// ---------------------------------------------------------------------------

enum ClassRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Deliberately not tied to an account — the public form works for visitors
// who don't have (or don't yet want) a platform login. userId is filled in
// opportunistically when the submitter happens to be signed in, purely so
// an approval can also raise an in-app Notification for them; email is the
// one contact channel guaranteed to exist for every registrant.
model ClassRegistration {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("ClassRegistrant", fields: [userId], references: [id], onDelete: SetNull)

  fullName   String
  email      String
  phone      String
  instrument PrimaryInstrument
  skillLevel SkillLevel
  notes      String?           @db.Text

  status ClassRegistrationStatus @default(PENDING)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ClassRegistrationReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Social — friends and 1-on-1 direct messages
// ---------------------------------------------------------------------------

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A friendship isn't a separate model — "are these two users friends" is
// just "does an ACCEPTED request exist between them, in either direction."
// Keeps the historical request itself (who asked whom, when) as the single
// record rather than duplicating it into a second table on acceptance.
model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  sender      User                @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
}

// One-directional — A blocking B doesn't block B from A's perspective in
// reverse, but sendFriendRequest/sendMessage check both directions before
// allowing contact, so a block is effective regardless of who initiated it.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockedBy", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// 1-on-1 only, no group threads — "conversations" are derived at query time
// (distinct counterpart + latest message), not a separate Conversation
// model, since there's nothing a thread record would own beyond that.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.Text
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt])
}

// A conversation "pinned" to the top of a user's own Messages sidebar —
// per-user, not mutual, so pinning a friend doesn't pin you on their side.
model PinnedConversation {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation("PinnedByUser", fields: [userId], references: [id], onDelete: Cascade)
  friendId String
  friend   User   @relation("PinnedFriend", fields: [friendId], references: [id], onDelete: Cascade)
  pinOrder Int

  createdAt DateTime @default(now())

  @@unique([userId, friendId])
  @@index([userId, pinOrder])
}

// One row per (sender, recipient) pair, upserted on every debounced
// keystroke in the composer. Freshness (updatedAt within the last few
// seconds), not a boolean, is what the recipient's poll checks — there's no
// "stopped typing" write, it just goes stale. Cleared explicitly on send so
// the indicator doesn't linger for the full staleness window.
model TypingStatus {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("TypingStatusSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("TypingStatusRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt

  @@unique([senderId, recipientId])
  @@index([recipientId, updatedAt])
}

// Group chat — additive alongside the 1-on-1 Message model above, not a
// replacement. Membership is friends-only at creation time (same trust
// boundary as 1-on-1 messaging); there's no post-creation invite/kick, only
// leaving, which keeps the moderation surface small for a first version.
model GroupConversation {
  id          String   @id @default(cuid())
  name        String? // optional — the UI falls back to listing member names
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members  GroupMember[]
  messages GroupMessage[]
}

// unreadCount is derived at query time from lastReadAt rather than a
// per-message read receipt row — there's no need to know exactly which
// message a member has seen, just "how many landed since they last looked."
model GroupMember {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("GroupMembership", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime          @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model GroupMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   GroupConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String            @db.Text
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js Prisma adapter shape)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set only for credentials-based signup
  role          Role      @default(STUDENT)

  // Optional — nothing in the app requires it except the friends/messages
  // system, which prompts for it inline rather than forcing it through the
  // (already-shipped) onboarding wizard. Always stored lowercase so
  // uniqueness is effectively case-insensitive without a citext extension.
  username String? @unique

  // Derived/cached entitlement flags — kept in sync whenever a ZellePayment
  // transitions to VERIFIED. Read by the NextAuth JWT callback so middleware
  // can gate routes without a DB round trip on the edge.
  hasCurriculumAccess  Boolean   @default(false)
  curriculumUnlockedAt DateTime?

  // 1 credit = 30 minutes of class, fixed regardless of which bundle it was
  // bought in — bundling only discounts the price paid, never the time
  // value. Spent from /lessons when booking a weekly group-class occurrence
  // (creditCost per ClassSchedule row), refunded on a >=24h-ahead
  // cancellation, forfeited on a late cancellation or a marked no-show.
  // Incremented on approval of a CLASS_CREDITS ZellePayment (see
  // approveZellePayment). Replaces the old online/in-person split — the
  // new weekly schedule is Zoom-only, one unified pool.
  classCredits Int @default(0)

  // Collected once by the mandatory post-registration wizard (middleware
  // redirects any signed-in-but-unonboarded user there). onboardedAt null
  // is the "must complete the wizard" signal; everything else is optional
  // even after that, since none of it gates access to anything.
  primaryInstrument PrimaryInstrument?
  skillLevel        SkillLevel?
  genres            MusicGenre[]       @default([])
  learningGoal      LearningGoal?
  onboardedAt       DateTime?

  // A day counts once (max) toward the streak the first time any practice
  // action (module read, practice logged, quiz attempted) happens that
  // calendar day — see recordPracticeActivity() in src/lib/gamification.ts.
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  // Per-category "also email me" toggles for the in-app notification
  // center — reminders default off since they're the closest thing to
  // marketing email here, unlike the other three which are transactional.
  notifyEmailPayments    Boolean @default(true)
  notifyEmailRoleUpdates Boolean @default(true)
  notifyEmailSocial      Boolean @default(true)
  notifyEmailReminders   Boolean @default(false)

  // Drives the "What's new" popup — shown once per calendar day (compared
  // in UTC) the first time a signed-in user hits any dashboard page, not on
  // every login. Null means "never seen one," which also shows it.
  lastSeenPatchNotesAt DateTime?

  accounts Account[]
  sessions Session[]

  notifications Notification[]

  announcementsCreated   Announcement[]          @relation("AnnouncementAuthor")
  announcementDismissals AnnouncementDismissal[] @relation("AnnouncementDismissedBy")

  progress         ScaleProgress[]
  quizAttempts     QuizAttempt[]
  zellePayments    ZellePayment[]  @relation("PaymentSubmitter")
  reviewedPayments ZellePayment[]  @relation("PaymentReviewer")
  lessonBookings   LessonBooking[] @relation("LessonBookingStudent") // historical — see LessonBooking model comment
  classBookings    ClassBooking[]  @relation("ClassBookingStudent")

  creditAdjustmentsReceived CreditAdjustment[] @relation("CreditAdjustmentRecipient")
  creditAdjustmentsGranted  CreditAdjustment[] @relation("CreditAdjustmentGrantedBy")

  uploadedLessons Lesson[]
  lessonProgress  LessonProgress[]

  verificationCodes VerificationCode[]
  trustedDevices    TrustedDevice[]
  loginEvents       LoginEvent[]
  badges            UserBadge[]

  sentFriendRequests     FriendRequest[]      @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[]      @relation("FriendRequestReceiver")
  blocksMade             Block[]              @relation("BlockedBy")
  blocksReceived         Block[]              @relation("BlockedUser")
  messagesSent           Message[]            @relation("MessageSender")
  messagesReceived       Message[]            @relation("MessageRecipient")
  pinnedByMe             PinnedConversation[] @relation("PinnedByUser")
  pinnedByOthers         PinnedConversation[] @relation("PinnedFriend")
  typingStatusesSent     TypingStatus[]       @relation("TypingStatusSender")
  typingStatusesReceived TypingStatus[]       @relation("TypingStatusRecipient")

  classRegistrations         ClassRegistration[] @relation("ClassRegistrant")
  reviewedClassRegistrations ClassRegistration[] @relation("ClassRegistrationReviewer")

  createdGroups     GroupConversation[] @relation("GroupCreator")
  groupMemberships  GroupMember[]       @relation("GroupMembership")
  groupMessagesSent GroupMessage[]      @relation("GroupMessageSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Security — email verification codes, 2FA, trusted devices, login history
// ---------------------------------------------------------------------------

// A single-use 6-digit code emailed for any sensitive action. Codes are
// hashed at rest (never store the raw digits) and scoped to one purpose, so
// a leaked LOGIN_2FA code can't be replayed against, say, CHANGE_PASSWORD.
// `payload` carries the pending value for CHANGE_* purposes (the new name,
// the new password hash, the new avatar data URI) — the change is only
// ever applied once the matching code is confirmed, never before.
model VerificationCode {
  id      String              @id @default(cuid())
  userId  String?
  email   String // the address the code was actually sent to
  purpose VerificationPurpose

  codeHash   String
  payload    Json?
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
}

// "Remember me for 7 days" — a browser holding a valid, unexpired token here
// skips the LOGIN_2FA code step on its next password login.
model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  label     String? // best-effort browser/OS description, cosmetic only
  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per successful login — what new-location detection compares
// against, and eventually a place a student could review their own account
// activity from.
model LoginEvent {
  id            String  @id @default(cuid())
  userId        String
  ip            String?
  city          String?
  region        String?
  country       String?
  userAgent     String?
  isNewLocation Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Curriculum
// ---------------------------------------------------------------------------

// One row per book scale group (Scale 0 ... Scale 5). Seeded once from the
// curriculum book — see prisma/seed.ts.
model ScaleGroup {
  id          String  @id @default(cuid())
  slug        String  @unique // "scale-0" .. "scale-5"
  order       Int     @unique // 0-5, defines the required sequencing
  code        String // "Scale 3"
  title       String // "Bati — Major, Minor & Lydian"
  kinitName   String? // "Bati Minor", "Tizita Major (Full Tizita)", etc.
  formula     String // degree formula, e.g. "1-b3-4-5-b7"
  description String? @db.Text

  // Vestigial — Pay-As-You-Go per-scale pricing was retired in favor of a
  // single $99 curriculum purchase (see CURRICULUM_PRICE_CENTS in
  // src/lib/curriculum.ts). Left in place rather than migrated away since
  // nothing reads it anymore; not worth a destructive column drop for it.
  priceCents Int @default(2500)

  progress      ScaleProgress[]
  quizAttempts  QuizAttempt[]
  zellePayments ZellePayment[]
  lessons       Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-authored course content (video or PDF) for one scale group's course
// player. Ordered, sequentially gated in the UI (src/lib/courseContent.ts /
// the /scales/[scaleSlug] course player) — not the same thing as
// LessonBooking above (that's a student booking live 1:1 time with the
// admin; this is pre-recorded/uploaded module content).
model Lesson {
  id              String          @id @default(cuid())
  scaleGroupId    String
  scaleGroup      ScaleGroup      @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  description     String?
  type            LessonMediaType
  fileUrl         String
  fileName        String
  fileSizeBytes   BigInt?
  durationSeconds Int? // video only, read from the file client-side on upload; left null for PDFs
  uploadedById    String
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  progress LessonProgress[]

  @@unique([scaleGroupId, order])
  @@index([scaleGroupId])
}

// Per-user completion of one Lesson — separate from ScaleProgress's
// moduleRead/practiceCompleted/quizPassed checklist so lesson-by-lesson
// tracking doesn't collide with it. Once every Lesson for a scale group has
// a row here for a given user, that's treated as equivalent to moduleRead
// (see syncLessonCompletionToModuleRead in src/lib/access.ts).
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId])
}

// Per-user, per-scale checklist + gating state.
model ScaleProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleGroupId String
  scaleGroup   ScaleGroup @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)

  status ProgressStatus @default(LOCKED)

  // (a) instructional module marked as read
  moduleRead   Boolean   @default(false)
  moduleReadAt DateTime?

  // (b) practical review completed
  practiceCompleted   Boolean   @default(false)
  practiceCompletedAt DateTime?

  // (c) conceptual/scale-spelling quiz passed
  quizPassed   Boolean   @default(false)
  quizScore    Int?
  quizPassedAt DateTime?

  unlockedAt  DateTime? // when access was granted (Pro purchase, Zelle verification, or override)
  completedAt DateTime? // when all three checklist items were satisfied

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scaleGroupId])
  @@index([userId, status])
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scaleGroupId String
  scaleGroup   ScaleGroup @relation(fields: [scaleGroupId], references: [id], onDelete: Cascade)

  score          Int
  totalQuestions Int
  result         QuizResult
  answers        Json // [{ questionId, selected, correct }]

  attemptedAt DateTime @default(now())

  @@index([userId, scaleGroupId])
}

// ---------------------------------------------------------------------------
// Commerce — Zelle manual verification
// ---------------------------------------------------------------------------

// Every Zelle transfer the platform expects to receive: the $99 curriculum
// purchase, a lesson-credit package, or (historically) a $25 per-scale
// unlock. This is the row the admin verification queue and the
// ZellePaymentModal both read/write.
model ZellePayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PaymentSubmitter", fields: [userId], references: [id], onDelete: Cascade)

  purpose PaymentPurpose

  // Only set on legacy rows where purpose == SCALE_UNLOCK
  scaleGroupId String?
  scaleGroup   ScaleGroup? @relation(fields: [scaleGroupId], references: [id])

  // Only set when purpose == LESSON_PACKAGE — the discount (if any) isn't
  // stored, it's recomputed from these two at render time via
  // calculateLessonTotal() so the admin queue can show it without drift.
  lessonQuantity Int?
  lessonType     LessonType?

  amountCents Int
  zelleHandle String // platform's receiving handle/email shown to the user at request time

  // Filled in by the student on the "I've sent it" step of the modal
  senderName    String?
  referenceCode String? // Zelle confirmation/reference number
  note          String? @db.Text
  screenshotUrl String? // optional proof-of-transfer upload

  status ZellePaymentStatus @default(AWAITING_TRANSFER)

  submittedAt DateTime? // student submitted a reference code
  reviewedAt  DateTime? // staff/automation made a decision

  reviewedById    String?
  reviewedBy      User?   @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
}

// HISTORICAL — this 1:1 on-request lesson system (student picks any
// date/time, admin coordinates out-of-band) was replaced by the weekly
// group-class schedule below (ClassSchedule/ClassBooking). Left in place,
// unwritten-to going forward, so past bookings/payments still resolve
// correctly rather than orphaning old rows.
model LessonBooking {
  id        String @id @default(cuid())
  studentId String
  student   User   @relation("LessonBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)

  type        LessonType
  scheduledAt DateTime
  meetingLink String? // filled in by the admin for ONLINE, once coordinated
  location    String? // filled in by the admin for IN_PERSON, once coordinated
  notes       String?    @db.Text

  status         LessonBookingStatus @default(SCHEDULED)
  canceledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, status])
  @@index([status, scheduledAt])
}

// ---------------------------------------------------------------------------
// Weekly group classes — recurring schedule + per-occurrence bookings.
// Replaces the 1:1 on-request LessonBooking system above.
// ---------------------------------------------------------------------------

enum ClassBookingStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  NO_SHOW
}

// One row per recurring weekly slot (e.g. "Monday 11:00am ET, 2 hours") —
// the template, not any specific week's occurrence. Repeats indefinitely;
// dayOfWeek/startTime are ET wall-clock, converted to real UTC instants
// per-occurrence by src/lib/classSchedule.ts (DST-correct, not a fixed
// offset — ET oscillates between EST/EDT across the year).
model ClassSchedule {
  id          String  @id @default(cuid())
  dayOfWeek   Int // 0=Sunday..6=Saturday, matches JS Date#getDay() in ET
  startTime   String // "HH:mm" 24h, ET wall-clock
  durationMin Int
  creditCost  Int // durationMin / 30 — 1 credit = 30 min, fixed regardless of how the credit was purchased
  label       String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())

  bookings ClassBooking[]

  @@index([dayOfWeek, active])
}

// One row per student per class occurrence. (scheduleId, occurrenceDate)
// together identify a specific week's instance of a recurring slot — that
// pair is what capacity (hard-capped at 10 SCHEDULED bookings) is counted
// against, and what the unique constraint below prevents double-booking.
model ClassBooking {
  id         String        @id @default(cuid())
  studentId  String
  student    User          @relation("ClassBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  // ET calendar date (stored at UTC midnight) identifying which week's
  // occurrence this is — the capacity/uniqueness key, independent of DST.
  occurrenceDate DateTime
  // The actual UTC instant the class starts — what's shown to the student
  // (converted to their local timezone client-side) and what the 24-hour
  // cancellation cutoff and admin roster ordering are computed from.
  scheduledAt    DateTime

  // Snapshotted from ClassSchedule.creditCost at booking time so a later
  // schedule edit never retroactively changes what a past booking cost.
  creditsSpent Int

  status         ClassBookingStatus @default(SCHEDULED)
  attendance     AttendanceStatus? // set by admin after the class happens; null until marked
  refunded       Boolean            @default(false) // true only for a >=24h-ahead self-cancellation
  canceledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, scheduleId, occurrenceDate])
  @@index([scheduleId, occurrenceDate, status])
  @@index([studentId, status])
}

// Audit trail for every manual admin change to a student's classCredits
// balance (grants, corrections, refunds outside the normal 24h-cutoff
// flow). amount is signed — positive for a grant, negative for a
// deduction — so the running total is just a sum of this table, and
// reasonNote is required at the call-site (never blank) so every entry is
// self-explanatory months later without cross-referencing anything else.
model CreditAdjustment {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation("CreditAdjustmentRecipient", fields: [userId], references: [id], onDelete: Cascade)
  adjustedById String
  adjustedBy   User   @relation("CreditAdjustmentGrantedBy", fields: [adjustedById], references: [id], onDelete: Cascade)

  amount     Int // signed: +N grants, -N deducts
  reasonNote String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
